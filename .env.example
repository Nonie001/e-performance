# Deployed Google Apps Script Web App URL (must end with /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must match the API_SECRET value in Apps Script Project Settings
APPS_SCRIPT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Generate a random value containing at least 32 characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
